generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model PROJET {
  id_projet         Int        @id @default(autoincrement())
  titre             String     @db.VarChar(50)
  description       String     @db.VarChar(50)
  date_creation     DateTime?  @default(now()) @db.Timestamp(0)
  date_modification DateTime?  @default(now()) @db.Timestamp(0)
  status            String     @db.VarChar(50)
  taches    TACHES[]
}

model TACHES {
  id_tache    Int        @id @default(autoincrement())
  titre       String     @db.VarChar(50)
  date_limite DateTime   @db.Date
  priorite    String     @db.VarChar(50)
  status      String     @db.VarChar(50)
  id_projet   Int                                    
  projet      PROJET   @relation(fields: [id_projet], references: [id_projet])
}
